# GENERATED by tools/gen_profile.py from qro/vocabulary.py. Edit the definition and run --write; never this file.
# QRO-Crate 0.1: 9 must-level shapes in SHACL Core (no SPARQL).
# The checker (python -m qro check) is the authority. A shape is a consequence of it. qs:claims names the
# refusals it mirrors, then the six of steps 1 and 2 that can come before its own: spelling, term-unknown,
# graph-form, context, file-missing, file-link. When a must shape fails the checker refuses the crate; a crate
# one fault from an accepted one is refused by a name a failing shape claims (README, limit 1).
# A report's sh:conforms is false for a Warning too; filter by sh:resultSeverity.
# Run an engine WITHOUT inference (pyshacl: inference=none, its default). With rdfs, owlrl or both it fails the
# accepted fixture crate on descriptor, entity and profile-entities, with 94, 112 and 527 results (README, limit 2).
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix qs: <https://github.com/loganw234/QRO-Crate/blob/main/profile/README.md#> .
@prefix qro: <https://github.com/loganw234/QRO-Crate/blob/main/docs/VOCABULARY.md#> .

qs:entity
    a sh:NodeShape ;
    sh:name "every entity: a named node of listed types, carrying only the profile's terms" ;
    sh:description "an entity is an IRI, has a type from the table, and carries no key the table does not name; a key neither the table nor RO-Crate's context names never reaches RDF, so it is the checker's alone" ;
    sh:message "an entity is a named node, of listed types, with only the profile's terms" ;
    sh:severity sh:Violation ;
    qs:claims "term-unknown", "field-kind", "graph-form", "spelling", "context", "file-missing", "file-link" ;
    sh:targetSubjectsOf rdf:type ;
    sh:targetSubjectsOf schema:about ;
    sh:targetSubjectsOf dct:conformsTo ;
    sh:targetSubjectsOf schema:mentions ;
    sh:targetSubjectsOf schema:license ;
    sh:targetSubjectsOf schema:name ;
    sh:targetSubjectsOf schema:description ;
    sh:targetSubjectsOf schema:version ;
    sh:targetSubjectsOf schema:hasPart ;
    sh:targetSubjectsOf schema:sha256 ;
    sh:targetSubjectsOf schema:contentSize ;
    sh:targetSubjectsOf schema:encodingFormat ;
    sh:targetSubjectsOf qro:rawForm ;
    sh:targetSubjectsOf qro:shots ;
    sh:targetSubjectsOf qro:generator ;
    sh:targetSubjectsOf schema:datePublished ;
    sh:targetSubjectsOf qro:writer ;
    sh:targetSubjectsOf qro:writtenAt ;
    sh:targetSubjectsOf qro:implementation ;
    sh:targetSubjectsOf qro:signature ;
    sh:targetSubjectsOf qro:trustedTime ;
    sh:targetSubjectsOf schema:instrument ;
    sh:targetSubjectsOf schema:object ;
    sh:targetSubjectsOf schema:result ;
    sh:targetSubjectsOf qro:deviceKind ;
    sh:targetSubjectsOf qro:device ;
    sh:targetSubjectsOf qro:jobId ;
    sh:targetSubjectsOf qro:line ;
    sh:targetSubjectsOf qro:kitCommit ;
    sh:targetSubjectsOf qro:role ;
    sh:targetSubjectsOf qro:basis ;
    sh:targetSubjectsOf qro:record ;
    sh:targetSubjectsOf qro:commitment ;
    sh:targetSubjectsOf qro:decodeRule ;
    sh:targetSubjectsOf qro:bitOrder ;
    sh:targetSubjectsOf qro:knownAnswer ;
    sh:targetSubjectsOf qro:calibrationLink ;
    sh:targetSubjectsOf qro:calibration ;
    sh:targetSubjectsOf qro:valuesDigest ;
    sh:targetSubjectsOf qro:stamp ;
    sh:targetSubjectsOf qro:newestValue ;
    sh:targetSubjectsOf qro:historyAtRunning ;
    sh:targetSubjectsOf qro:clock ;
    sh:targetSubjectsOf schema:startTime ;
    sh:targetSubjectsOf schema:endTime ;
    sh:targetSubjectsOf qro:law ;
    sh:targetSubjectsOf qro:lawCircuit ;
    sh:targetSubjectsOf qro:twins ;
    sh:targetSubjectsOf qro:measureSet ;
    sh:targetSubjectsOf qro:alpha ;
    sh:targetSubjectsOf qro:family ;
    sh:targetSubjectsOf qro:measure ;
    sh:targetSubjectsOf qro:twin ;
    sh:targetSubjectsOf qro:class ;
    sh:targetSubjectsOf qro:lawValue ;
    sh:targetSubjectsOf qro:twinValue ;
    sh:targetSubjectsOf qro:measuredPub ;
    sh:targetSubjectsOf qro:inScope ;
    sh:targetSubjectsOf qro:value ;
    sh:targetSubjectsOf qro:lower ;
    sh:targetSubjectsOf qro:upper ;
    sh:targetSubjectsOf qro:heldCompile ;
    sh:targetSubjectsOf qro:holdRule ;
    sh:targetSubjectsOf qro:exactHold ;
    sh:nodeKind sh:IRI ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type schema:about dct:conformsTo schema:mentions schema:license schema:name schema:description schema:version schema:hasPart schema:sha256 schema:contentSize schema:encodingFormat qro:rawForm qro:shots qro:generator schema:datePublished qro:writer qro:writtenAt qro:implementation qro:signature qro:trustedTime schema:instrument schema:object schema:result qro:deviceKind qro:device qro:jobId qro:line qro:kitCommit qro:role qro:basis qro:record qro:commitment qro:decodeRule qro:bitOrder qro:knownAnswer qro:calibrationLink qro:calibration qro:valuesDigest qro:stamp qro:newestValue qro:historyAtRunning qro:clock schema:startTime schema:endTime qro:law qro:lawCircuit qro:twins qro:measureSet qro:alpha qro:family qro:measure qro:twin qro:class qro:lawValue qro:twinValue qro:measuredPub qro:inScope qro:value qro:lower qro:upper qro:heldCompile qro:holdRule qro:exactHold ) ;
    sh:property [
        sh:path rdf:type ;
        sh:message "an entity has a type, and it is one the profile lists" ;
        sh:severity sh:Violation ;
        sh:in ( schema:Dataset schema:MediaObject schema:CreativeWork prof:Profile schema:CreateAction schema:IndividualProduct schema:SoftwareApplication qro:Question qro:Job qro:Pub qro:Decode qro:Compile qro:Snapshot qro:Measuring qro:Contrast qro:Measurement qro:Hold qro:RawResult ) ;
        sh:minCount 1
    ] .

qs:descriptor
    a sh:NodeShape ;
    sh:name "the metadata descriptor" ;
    sh:description "a CreativeWork about the root that conformsTo RO-Crate 1.3, and nothing more" ;
    sh:message "the descriptor is a CreativeWork about the root that conformsTo RO-Crate 1.3, and nothing more" ;
    sh:severity sh:Violation ;
    qs:claims "graph-form", "spelling", "term-unknown", "context", "file-missing", "file-link" ;
    sh:targetSubjectsOf schema:about ;
    sh:pattern "(^|/)ro-crate-metadata\\.json$" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path rdf:type ;
        sh:severity sh:Violation ;
        sh:hasValue schema:CreativeWork ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path schema:about ;
        sh:severity sh:Violation ;
        sh:nodeKind sh:IRI ;
        sh:pattern "/$" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path dct:conformsTo ;
        sh:severity sh:Violation ;
        sh:hasValue <https://w3id.org/ro/crate/1.3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

qs:root
    a sh:NodeShape ;
    sh:name "the root data entity" ;
    sh:description "a Dataset, never an action, with every term the profile requires of a root, conformsTo exactly Process Run Crate and this profile, mentioning only actions" ;
    sh:message "the root is a Dataset, never an action, with the terms the profile requires of it" ;
    sh:severity sh:Violation ;
    qs:claims "graph-form", "spelling", "term-unknown", "context", "file-missing", "file-link" ;
    sh:targetObjectsOf schema:about ;
    sh:class schema:Dataset ;
    sh:not [
        sh:class schema:CreateAction
    ] ;
    sh:property [
        sh:path schema:datePublished ;
        sh:severity sh:Violation ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:severity sh:Violation ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path schema:hasPart ;
        sh:severity sh:Violation ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path schema:license ;
        sh:severity sh:Violation ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:severity sh:Violation ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qro:generator ;
        sh:severity sh:Violation ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qro:signature ;
        sh:severity sh:Violation ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qro:trustedTime ;
        sh:severity sh:Violation ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qro:writer ;
        sh:severity sh:Violation ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qro:writtenAt ;
        sh:severity sh:Violation ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path dct:conformsTo ;
        sh:severity sh:Violation ;
        sh:hasValue <https://w3id.org/ro/wfrun/process/0.6> ;
        sh:hasValue <https://github.com/loganw234/QRO-Crate/blob/main/profile/README.md> ;
        sh:minCount 2 ;
        sh:maxCount 2
    ] ;
    sh:property [
        sh:path schema:mentions ;
        sh:severity sh:Violation ;
        sh:class schema:CreateAction
    ] .

qs:action-mentioned
    a sh:NodeShape ;
    sh:name "every action is mentioned by the root" ;
    sh:description "the root mentions every action in the crate" ;
    sh:message "an action the root does not mention" ;
    sh:severity sh:Violation ;
    qs:claims "graph-form", "spelling", "term-unknown", "context", "file-missing", "file-link" ;
    sh:targetClass schema:CreateAction ;
    sh:property [
        sh:path [ sh:inversePath schema:mentions ] ;
        sh:message "an action the root does not mention" ;
        sh:severity sh:Violation ;
        sh:minCount 1
    ] .

qs:file-digest-present
    a sh:NodeShape ;
    sh:name "a File the crate holds names its digest and size" ;
    sh:description "a File with a path in the crate carries sha256 and contentSize; one whose IRI is not a file: IRI, or holds a #, is not held to it" ;
    sh:message "a File the crate holds names its digest and size" ;
    sh:severity sh:Violation ;
    qs:claims "file-digest", "raw-digest", "spelling", "term-unknown", "graph-form", "context", "file-missing", "file-link" ;
    sh:targetClass schema:MediaObject ;
    sh:or (
        [
            sh:pattern "#"
        ]
        [
            sh:not [
                sh:pattern "^file:"
            ]
        ]
        [
            sh:property [
                sh:path schema:sha256 ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path schema:contentSize ;
                sh:minCount 1
            ]
        ]
    ) .

qs:file-reached
    a sh:NodeShape ;
    sh:name "a File with a digest is reached from the root" ;
    sh:description "every File with a sha256 is reached from the root through hasPart; a file on disk that no entity lists is the checker's alone" ;
    sh:message "a File that no hasPart reaches from the root" ;
    sh:severity sh:Violation ;
    qs:claims "file-unlisted", "graph-form", "spelling", "term-unknown", "context", "file-missing", "file-link" ;
    sh:targetSubjectsOf schema:sha256 ;
    sh:property [
        sh:path [ sh:oneOrMorePath [ sh:inversePath schema:hasPart ] ] ;
        sh:message "a File that no hasPart reaches from the root" ;
        sh:severity sh:Violation ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path [ sh:inversePath schema:about ] ;
                sh:minCount 1
            ]
        ] ;
        sh:qualifiedMinCount 1
    ] .

qs:rawresult-form
    a sh:NodeShape ;
    sh:name "a raw result is a File and names its raw form" ;
    sh:description "a raw result is a File and names the form its bytes take; its shots are counted from its bytes by the checker, never stated beside them" ;
    sh:message "a raw result is a File and names its raw form" ;
    sh:severity sh:Violation ;
    qs:claims "raw-form", "graph-form", "file-unlisted", "spelling", "term-unknown", "context", "file-missing", "file-link" ;
    sh:targetClass qro:RawResult ;
    sh:class schema:MediaObject ;
    sh:property [
        sh:path qro:rawForm ;
        sh:severity sh:Violation ;
        sh:minCount 1
    ] .

qs:profile-entities
    a sh:NodeShape ;
    sh:name "each profile the root conformsTo has its contextual entity" ;
    sh:description "the contextual entity of this profile and of Process Run Crate, each with its type and name as the table states them, and no other Profile entity" ;
    sh:message "a profile's contextual entity is missing, or is not as the table states it" ;
    sh:severity sh:Violation ;
    qs:claims "graph-form", "spelling", "term-unknown", "context", "file-missing", "file-link" ;
    sh:targetNode <https://github.com/loganw234/QRO-Crate/blob/main/profile/README.md> ;
    sh:targetNode <https://w3id.org/ro/wfrun/process/0.6> ;
    sh:targetClass prof:Profile ;
    sh:or (
        [
            sh:hasValue <https://github.com/loganw234/QRO-Crate/blob/main/profile/README.md> ;
            sh:closed true ;
            sh:ignoredProperties ( rdf:type ) ;
            sh:property [
                sh:path rdf:type ;
                sh:hasValue schema:CreativeWork ;
                sh:hasValue prof:Profile ;
                sh:minCount 2 ;
                sh:maxCount 2
            ] ;
            sh:property [
                sh:path schema:name ;
                sh:hasValue "QRO-Crate" ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path schema:version
            ]
        ]
        [
            sh:hasValue <https://w3id.org/ro/wfrun/process/0.6> ;
            sh:closed true ;
            sh:ignoredProperties ( rdf:type ) ;
            sh:property [
                sh:path rdf:type ;
                sh:hasValue schema:CreativeWork ;
                sh:hasValue prof:Profile ;
                sh:minCount 2 ;
                sh:maxCount 2
            ] ;
            sh:property [
                sh:path schema:name ;
                sh:hasValue "Process Run Crate" ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path schema:version
            ]
        ]
    ) .

qs:profile-version
    a sh:NodeShape ;
    sh:name "each profile's contextual entity declares the version the table holds" ;
    sh:description "this reader reads one version of each profile: another is refused as context" ;
    sh:message "a profile's contextual entity declares another version than this reader reads" ;
    sh:severity sh:Violation ;
    qs:claims "context", "graph-form", "spelling", "term-unknown", "file-missing", "file-link" ;
    sh:targetNode <https://github.com/loganw234/QRO-Crate/blob/main/profile/README.md> ;
    sh:targetNode <https://w3id.org/ro/wfrun/process/0.6> ;
    sh:or (
        [
            sh:hasValue <https://github.com/loganw234/QRO-Crate/blob/main/profile/README.md> ;
            sh:property [
                sh:path schema:version ;
                sh:hasValue "0.1" ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:hasValue <https://w3id.org/ro/wfrun/process/0.6> ;
            sh:property [
                sh:path schema:version ;
                sh:hasValue "0.6" ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) .
